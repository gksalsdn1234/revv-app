rules_version = '2';

// REVV — Firestore 보안 규칙
//
// 정책: 익명 인증 사용자는 자기 uid 하위 데이터만 읽기/쓰기 가능.
//       다른 사용자의 데이터는 완전 차단.
//
// 배포: firebase deploy --only firestore:rules --project revv-eb7c9
//       (프로젝트 루트에서 실행)

service cloud.firestore {
  match /databases/{database}/documents {

    // users/{uid}/** — 로그인 사용자가 자기 uid 소유인 경우만 허용
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid;
    }

    // routes/{routeId} — 전역 커뮤니티 루트 메타 (nodes 제외 경량 문서)
    //   read:   모든 로그인 유저 가능
    //   create: 모든 로그인 유저 가능 (최초 발견자 게시)
    //   update: runCount +1만 허용 (주행 완료 시 atomic increment)
    match /routes/{routeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data)
                       .affectedKeys().hasOnly(['runCount', '_updatedAt'])
                    && request.resource.data.runCount
                       == resource.data.runCount + 1;
    }

    // routes/{routeId}/detail/{doc} — 노드 배열 (대용량, 선택 시 lazy 로드)
    //   read:   모든 로그인 유저 가능
    //   create: 모든 로그인 유저 가능 (최초 게시 시 메타와 동시 작성)
    //   update: 금지 (nodes는 canonical — 덮어쓰기 불가)
    match /routes/{routeId}/detail/{doc} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if false;
    }

    // routes/{routeId}/runs/{uid} — 유저별 주행 기록 서브컬렉션
    match /routes/{routeId}/runs/{uid} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid;
    }

    // users/{uid}/records/{routeId} — 개인 기록(PR) 저장
    match /users/{uid}/records/{routeId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid;
    }

    // 그 외 모든 경로 — 명시적 거부
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
