FROM ghcr.io/astral-sh/uv:0.11.8@sha256:3b7b60a81d3c57ef471703e5c83fd4aaa33abcd403596fb22ab07db85ae91347 AS uv-bin

FROM python:3.12.11-slim-bookworm@sha256:519591d6871b7bc437060736b9f7456b8731f1499a57e22e6c285135ae657bf7 AS osmium-builder

ARG OSMIUM_TOOL_VERSION=1.19.0
ARG OSMIUM_TOOL_SHA256=70e77f69b671528a99b1b01ce6de3e834e3170b20e4c38f4b52ceb4b0eba7263
ARG LIBOSMIUM_VERSION=2.20.0
ARG LIBOSMIUM_SHA256=b68afee19b3fd6a75030ac8a95f6da2268579efe86b32ad736d22caeee41a8e7

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        libboost-program-options-dev \
        libbz2-dev \
        libexpat1-dev \
        liblz4-dev \
        libprotozero-dev \
        nlohmann-json3-dev \
        zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
RUN curl --fail --location --silent --show-error \
        --output libosmium.tar.gz \
        "https://api.github.com/repos/osmcode/libosmium/tarball/v${LIBOSMIUM_VERSION}" \
    && echo "${LIBOSMIUM_SHA256}  libosmium.tar.gz" | sha256sum --check --strict \
    && mkdir libosmium-source \
    && tar --extract --gzip --strip-components=1 --directory libosmium-source --file libosmium.tar.gz \
    && cp -R libosmium-source/include/osmium /usr/local/include/ \
    && curl --fail --location --silent --show-error \
        --output osmium-tool.tar.gz \
        "https://api.github.com/repos/osmcode/osmium-tool/tarball/v${OSMIUM_TOOL_VERSION}" \
    && echo "${OSMIUM_TOOL_SHA256}  osmium-tool.tar.gz" | sha256sum --check --strict \
    && mkdir osmium-tool-source \
    && tar --extract --gzip --strip-components=1 --directory osmium-tool-source --file osmium-tool.tar.gz \
    && cmake -S osmium-tool-source -B build-output -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF \
    && cmake --build build-output --parallel 1 \
    && cmake --install build-output

FROM python:3.12.11-slim-bookworm@sha256:519591d6871b7bc437060736b9f7456b8731f1499a57e22e6c285135ae657bf7 AS western-source

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        libboost-program-options1.74.0 \
        libbz2-1.0 \
        libexpat1 \
        liblz4-1 \
        zlib1g \
    && rm -rf /var/lib/apt/lists/*

COPY --from=uv-bin /uv /usr/local/bin/uv
COPY --from=osmium-builder /usr/local/bin/osmium /usr/local/bin/osmium
COPY tools/curvature_pipeline/western_sources/requirements-western.lock /tmp/requirements-western.lock
RUN uv pip install --system --no-cache --require-hashes --requirement /tmp/requirements-western.lock

WORKDIR /app
ENV PYTHONPATH=/app
COPY tools /app/tools

RUN python --version \
    && uv --version \
    && osmium --version \
    && python -c "from importlib.metadata import version; print({name: version(name) for name in ('httpx2','networkx','osmium','pip-tools','pydantic','typer')})"

ENTRYPOINT ["python", "tools/curvature_pipeline/acquire_western_sources.py"]
